# Aegis-RTO Environment Variables

# Primary Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_LLM_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq

# Alternative LLM Providers (Optional fallbacks)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# PostgreSQL Database Connection
# Local: postgresql://postgres:postgres@localhost:5432/aegis_rto
# Cloud (e.g. Neon / Supabase): postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegis_rto

# App & Evaluation Configuration
ENVIRONMENT=development
PORT=8000
AVOIDED_RTO_COST_INR=250.0
FP_MARGIN_LOSS_RATE=0.15
RULE_TIMEOUT_SEC=3.0
